generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  HOMEOWNER
  VENDOR
  FINANCING_PARTNER
  ADMIN
}

enum HomeownerAccountType {
  VERIFIED_HOMEOWNER
  SERVICE_ONLY
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MembershipStatus {
  NONE
  ACTIVE
  PAST_DUE
  CANCELED
}

enum RequestStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum PaymentStatus {
  UNPRICED
  UNPAID
  PAID
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  passwordHash         String
  name                 String
  phone                String?
  role                 Role
  createdAt            DateTime              @default(now())
  agreementAcceptedAt  DateTime?
  agreementVersion     String?
  approvalStatus       ApplicationStatus     @default(PENDING)
  approvalReviewedAt   DateTime?
  approvalReviewedBy   String?
  firstLoginAt         DateTime?
  sessions             AuthSession[]
  passwordResets       PasswordReset[]
  agreementAcceptances AgreementAcceptance[]

  membership                Membership?
  documents                 Document[]
  financingRequests         FinancingRequest[]
  serviceRequests           ServiceRequest[]
  appointments              Appointment[]
  vendorProfile             VendorProfile?
  financingProfile          FinancingPartnerProfile?
  marketplaceListing        MarketplaceListing?
  vendorReferrals           VendorReferral[]                    @relation("VendorReferrals")
  referredBy                VendorReferral?                     @relation("CustomerReferral")
  characterEntitlement      CharacterEntitlement?
  characterUsage            CharacterUsage[]
  accountStatus             String                              @default("ACTIVE")
  canceledAt                DateTime?
  cancellationReason        String?
  financingAccessStatus     String                              @default("ACTIVE")
  passwordSetupRequired     Boolean                             @default(false)
  homeownerAccountType      HomeownerAccountType                @default(VERIFIED_HOMEOWNER)
  homeownerVerificationStatus String                            @default("UNVERIFIED")
  memberStandingAcceptances MemberStandingAcceptance[]
  lenderReportsSubmitted    FinancingStatusReport[]             @relation("ReportMember")
  lenderReportsReceived     FinancingStatusReport[]             @relation("ReportPartner")
  notifications             UserNotification[]
  cancellationAudits        AccountCancellationAudit[]
  financingDisputes         FinancingStatusDispute[]
  reportingAcceptances      FinancePartnerReportingAcceptance[]
  setupTokens               AccountSetupToken[]
}

model AuthSession {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  welcomePending Boolean  @default(true)
  firstLogin     Boolean  @default(false)
  returnTo       String

  @@index([userId])
  @@index([expiresAt])
}

model CharacterEntitlement {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  freeSecondsRemaining    Int       @default(60)
  paidSecondsRemaining    Int       @default(0)
  plan                    String?
  purchasedAt             DateTime?
  expiresAt               DateTime?
  status                  String    @default("FREE")
  stripeCheckoutSessionId String?   @unique
  stripePaymentIntentId   String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model CharacterUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  character String
  seconds   Int
  source    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model VendorReferral {
  id           String    @id @default(cuid())
  code         String    @unique
  vendorUserId String
  vendor       User      @relation("VendorReferrals", fields: [vendorUserId], references: [id], onDelete: Cascade)
  customerId   String?   @unique
  customer     User?     @relation("CustomerReferral", fields: [customerId], references: [id], onDelete: SetNull)
  status       String    @default("SENT")
  createdAt    DateTime  @default(now())
  acceptedAt   DateTime?

  @@index([vendorUserId, createdAt])
}

model NetworkAgreement {
  id                 String   @id @default(cuid())
  role               Role
  version            String
  title              String
  content            String
  effectiveDate      DateTime
  documentIdentifier String
  active             Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@unique([role, version])
}

model AgreementAcceptance {
  id                         String   @id @default(cuid())
  userId                     String
  user                       User     @relation(fields: [userId], references: [id])
  role                       Role
  version                    String
  agreementType              String
  agreementTitle             String
  effectiveDate              DateTime
  documentIdentifier         String
  fullLegalName              String
  companyName                String?
  electronicSignature        String
  consentToElectronicRecords Boolean
  acceptanceStatus           String   @default("ACCEPTED")
  signedCopyContent          String
  ipAddress                  String?
  userAgent                  String?
  acceptedAt                 DateTime @default(now())

  @@unique([userId, role, version])
  @@index([role, version])
}

model ApprovalAudit {
  id         String            @id @default(cuid())
  userId     String
  adminId    String
  status     ApplicationStatus
  reviewedAt DateTime          @default(now())

  @@index([userId])
}

model AdminAccountActionAudit {
  id          String   @id @default(cuid())
  userId      String
  adminId     String
  action      String
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([adminId, createdAt])
}

model SiteExperienceSettings {
  id               String   @id
  weatherEnabled   Boolean  @default(true)
  seasonalEnabled  Boolean  @default(true)
  holidayEnabled   Boolean  @default(true)
  effectsDisabled  Boolean  @default(false)
  previewTheme     String?
  updatedAt        DateTime @updatedAt
}

model BixySettings {
  id                    String   @id
  enabled               Boolean  @default(true)
  showOnPages           String[] @default(["*"])
  maintenanceMode       Boolean  @default(false)
  maintenanceMessage    String   @default("Bixy is taking a short break. Please use the SturdiHome navigation for help.")
  voiceOutputEnabled    Boolean  @default(true)
  voiceInputEnabled     Boolean  @default(true)
  typedChatEnabled      Boolean  @default(true)
  animationMode         String   @default("basic")
  mouthAnimationEnabled Boolean  @default(true)
  guidanceEnabled       Boolean  @default(true)
  pageHelpEnabled       Boolean  @default(true)
  sessionPersistence    Boolean  @default(true)
  freePreviewSeconds    Int      @default(60)
  paidAccessEnabled     Boolean  @default(false)
  pricingJson           Json
  greeting              String   @default("Well hello there. I am Bixy, your dependable SturdiHome guide.")
  fallbackMessage       String   @default("I do not have that information. Please use the SturdiHome navigation or contact the SturdiHome team for help.")
  personalityText       String   @default("You are Bixy, a male older-man SturdiHome guide. Always use he/him pronouns. Speak warmly, confidently, naturally, and with family-friendly humor.")
  allowedDestinations   Json
  updatedAt             DateTime @updatedAt
  audits                BixyConfigAudit[]
}

model BixyConfigAudit {
  id          String   @id @default(cuid())
  settingsId  String
  adminId     String
  changedKeys String[]
  beforeJson  Json
  afterJson   Json
  createdAt   DateTime @default(now())
  settings    BixySettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@index([settingsId, createdAt])
  @@index([adminId, createdAt])
}

model BixyRefundAudit {
  id                    String   @id @default(cuid())
  adminId               String
  userId                String
  paymentIntentId       String
  stripeRefundId        String?  @unique
  plan                  String?
  originalAmountCents   Int
  refundPercentage      Int
  refundAmountCents     Int
  remainingCents        Int?
  status                String
  errorMessage          String?
  createdAt             DateTime @default(now())

  @@index([paymentIntentId, createdAt])
  @@index([userId, createdAt])
}

model ServiceCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  label       String
  description String   @default("")
  imageUrl    String   @default("")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteAnnouncement {
  id        String   @id @default(cuid())
  title     String
  body      String
  ctaLabel  String?
  ctaHref   String?
  startsAt  DateTime?
  endsAt    DateTime?
  active    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteMediaAsset {
  id          String   @id @default(cuid())
  label       String
  description String   @default("")
  mediaType   String
  sourceUrl   String
  storageKey  String?
  altText     String   @default("")
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteContentPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  body        String
  published   Boolean  @default(false)
  protected   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteNavigationItem {
  id        String   @id @default(cuid())
  label     String
  href      String
  visible   Boolean  @default(true)
  sortOrder Int      @default(0)
  required  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordReset {
  tokenHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([userId])
}

model AccountSetupToken {
  tokenHash  String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([userId, expiresAt])
}

model AuthThrottle {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

// Published business information for authenticated network users. No homeowner leads.
model MarketplaceListing {
  id          String   @id @default(cuid())
  ownerId     String   @unique
  owner       User     @relation(fields: [ownerId], references: [id])
  kind        String
  companyName String
  description String
  services    String
  categories  String[] @default([])
  areas       String[] @default([])
  website     String   @default("")
  email       String   @default("")
  phone       String   @default("")
  logo        String   @default("")
  photos      String[] @default([])
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model Membership {
  id              String           @id @default(cuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id])
  plan            String           @default("SturdiHome Membership - Standard")
  priceCents      Int              @default(1900)
  status          MembershipStatus @default(NONE)
  activatedAt     DateTime?
  nextBillingDate DateTime?
  canceledAt      DateTime?
}

model VendorProfile {
  id              String            @id @default(cuid())
  userId          String            @unique
  user            User              @relation(fields: [userId], references: [id])
  companyName     String
  serviceArea     String
  servicesOffered String
  status          ApplicationStatus @default(PENDING)
  appliedAt       DateTime          @default(now())
  reviewedAt      DateTime?
  serviceRequests ServiceRequest[]
  flyers          VendorFlyer[]

  membershipStatus           MembershipStatus @default(NONE)
  membershipTier             String?
  stripeCustomerId           String?
  stripeSubscriptionId       String?
  membershipActivatedAt      DateTime?
  membershipCurrentPeriodEnd DateTime?
  membershipCanceledAt       DateTime?

  applicationFeePaidAt DateTime?
  foundingVendor       Boolean   @default(false)
  maxActiveJobs        Int       @default(1)
  availabilityStatus   String    @default("AVAILABLE")
}

model VendorFlyer {
  id              String            @id @default(cuid())
  vendorProfileId String
  vendorProfile   VendorProfile     @relation(fields: [vendorProfileId], references: [id])
  fileName        String
  label           String
  status          ApplicationStatus @default(PENDING)
  uploadedAt      DateTime          @default(now())
  reviewedAt      DateTime?
}

model FinancingPartnerProfile {
  id                   String                              @id @default(cuid())
  userId               String                              @unique
  user                 User                                @relation(fields: [userId], references: [id])
  companyName          String
  licenseInfo          String
  status               ApplicationStatus                   @default(PENDING)
  appliedAt            DateTime                            @default(now())
  reviewedAt           DateTime?
  financingRequests    FinancingRequest[]
  statusReports        FinancingStatusReport[]             @relation("ReportPartnerProfile")
  reportingAcceptances FinancePartnerReportingAcceptance[]

  paymentStatus         PaymentStatus @default(UNPAID)
  stripeCustomerId      String?
  stripePaymentIntentId String?
  paidAt                DateTime?
}

model MemberStandingAcceptance {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version             String
  effectiveDate       DateTime
  documentIdentifier  String
  fullLegalName       String
  electronicSignature String
  signedCopyContent   String
  acceptedAt          DateTime @default(now())

  @@unique([userId, version])
  @@index([userId, acceptedAt])
}

model FinancePartnerReportingAcceptance {
  id                        String                   @id @default(cuid())
  userId                    String
  user                      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version                   String
  documentIdentifier        String
  fullLegalName             String
  electronicSignature       String
  signedCopyContent         String
  acceptedAt                DateTime                 @default(now())
  financingPartnerProfile   FinancingPartnerProfile? @relation(fields: [financingPartnerProfileId], references: [id])
  financingPartnerProfileId String?

  @@unique([userId, version])
}

model FinancingStatusReport {
  id                        String                   @id @default(cuid())
  financePartnerUserId      String
  financePartnerUser        User                     @relation("ReportPartner", fields: [financePartnerUserId], references: [id], onDelete: Restrict)
  financePartnerProfileId   String
  financePartnerProfile     FinancingPartnerProfile  @relation("ReportPartnerProfile", fields: [financePartnerProfileId], references: [id], onDelete: Restrict)
  memberId                  String
  member                    User                     @relation("ReportMember", fields: [memberId], references: [id], onDelete: Restrict)
  financingRequestId        String
  financingRequest          FinancingRequest         @relation(fields: [financingRequestId], references: [id], onDelete: Restrict)
  status                    String
  relationshipReference     String?
  authorizationConfirmed    Boolean
  accuracyConfirmed         Boolean
  ownRelationshipConfirmed  Boolean
  noCollectionConfirmed     Boolean
  updateCommitmentConfirmed Boolean
  active                    Boolean                  @default(true)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  resolvedAt                DateTime?
  disputes                  FinancingStatusDispute[]
  audits                    FinancingStatusAudit[]
  notifications             UserNotification[]

  @@index([memberId, active, createdAt])
  @@index([financePartnerUserId, createdAt])
}

model FinancingStatusDispute {
  id         String                @id @default(cuid())
  reportId   String
  report     FinancingStatusReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  memberId   String
  member     User                  @relation(fields: [memberId], references: [id], onDelete: Restrict)
  response   String
  status     String                @default("OPEN")
  reviewedBy String?
  reviewedAt DateTime?
  adminNotes String?
  createdAt  DateTime              @default(now())

  @@index([memberId, createdAt])
  @@index([reportId, createdAt])
}

model FinancingStatusAudit {
  id          String                @id @default(cuid())
  reportId    String
  report      FinancingStatusReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actorUserId String
  action      String
  reason      String?
  createdAt   DateTime              @default(now())

  @@index([reportId, createdAt])
}

model UserNotification {
  id        String                 @id @default(cuid())
  userId    String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportId  String?
  report    FinancingStatusReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime               @default(now())

  @@index([userId, createdAt])
}

model AccountCancellationAudit {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  actorUserId String
  reason      String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model Document {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  label      String
  documentType String?
  fileName   String
  uploadedAt DateTime @default(now())
}

model FinancingRequest {
  id                 String                   @id @default(cuid())
  homeownerId        String
  homeowner          User                     @relation(fields: [homeownerId], references: [id])
  projectDescription String
  amountRequested    Int
  status             RequestStatus            @default(NEW)
  assignedPartnerId  String?
  assignedPartner    FinancingPartnerProfile? @relation(fields: [assignedPartnerId], references: [id])
  notes              String?
  serviceRequestId   String? @unique
  serviceRequest     ServiceRequest? @relation(fields: [serviceRequestId], references: [id])
  lenderStatus       String           @default("RECEIVED")
  financedLineItems  Json?
  createdAt          DateTime                 @default(now())
  statusReports      FinancingStatusReport[]
}

model ServiceRequest {
  id               String         @id @default(cuid())
  homeownerId      String
  homeowner        User           @relation(fields: [homeownerId], references: [id])
  serviceType      String
  description      String
  status           RequestStatus  @default(NEW)
  assignedVendorId String?
  assignedVendor   VendorProfile? @relation(fields: [assignedVendorId], references: [id])
  createdAt        DateTime       @default(now())
  appointment      Appointment?
  financingRequests FinancingRequest[]
  quoteItems       QuoteLineItem[]
  changeOrders     ChangeOrder[]
  workflowStatus   String         @default("ESTIMATE_SUBMITTED")
  vendorResponse   String?
  vendorResponseAt DateTime?
  siteVisitScheduledFor DateTime?
  siteVisitCompletedAt DateTime?
  finalQuoteSubmittedAt DateTime?
  quoteAcceptedAt DateTime?
  quoteAcceptedBy String?
  finalQuoteTotalCents Int?
  completedAt DateTime?
  completedBy String?

  // Deprecated: homeowner-pays-vendor-directly flow has been removed from the app.
  // Left in place (unused) rather than dropped, to avoid a destructive migration over
  // what's currently just test data.
  priceCents              Int?
  paymentStatus           PaymentStatus @default(UNPRICED)
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  paidAt                  DateTime?

  estimateLowCents  Int?
  estimateHighCents Int?
}

model QuoteLineItem {
  id               String         @id @default(cuid())
  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  category         String
  description      String
  amountCents      Int
  createdAt        DateTime       @default(now())

  @@index([serviceRequestId, createdAt])
}

model ChangeOrder {
  id                   String         @id @default(cuid())
  serviceRequestId     String
  serviceRequest       ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  originalAmountCents  Int
  requestedAmountCents Int
  reason               String
  status               String         @default("PENDING_HOMEOWNER")
  approvedAt           DateTime?
  approvedBy           String?
  createdAt            DateTime       @default(now())

  @@index([serviceRequestId, createdAt])
}

model ServiceRequestAudit {
  id               String   @id @default(cuid())
  serviceRequestId String
  actorUserId      String
  previousStatus   String?
  newStatus        String
  note             String?
  createdAt        DateTime @default(now())

  @@index([serviceRequestId, createdAt])
}

model Appointment {
  id               String          @id @default(cuid())
  homeownerId      String
  homeowner        User            @relation(fields: [homeownerId], references: [id])
  serviceRequestId String?         @unique
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id])
  scheduledFor     DateTime
  status           String          @default("SCHEDULED")
  createdAt        DateTime        @default(now())
}
