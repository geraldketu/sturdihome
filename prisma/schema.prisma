generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  HOMEOWNER
  VENDOR
  FINANCING_PARTNER
  ADMIN
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MembershipStatus {
  NONE
  ACTIVE
  PAST_DUE
  CANCELED
}

enum RequestStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum PaymentStatus {
  UNPRICED
  UNPAID
  PAID
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  name                String
  phone               String?
  role                Role
  createdAt           DateTime  @default(now())
  agreementAcceptedAt DateTime?

  membership         Membership?
  documents          Document[]
  financingRequests  FinancingRequest[]
  serviceRequests    ServiceRequest[]
  appointments       Appointment[]
  vendorProfile      VendorProfile?
  financingProfile   FinancingPartnerProfile?
}

model Membership {
  id              String            @id @default(cuid())
  userId          String            @unique
  user            User              @relation(fields: [userId], references: [id])
  plan            String            @default("SturdiHome Membership - Standard")
  priceCents      Int               @default(1900)
  status          MembershipStatus  @default(NONE)
  activatedAt     DateTime?
  nextBillingDate DateTime?
  canceledAt      DateTime?
}

model VendorProfile {
  id               String            @id @default(cuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id])
  companyName      String
  serviceArea      String
  servicesOffered  String
  status           ApplicationStatus @default(PENDING)
  appliedAt        DateTime          @default(now())
  reviewedAt       DateTime?
  serviceRequests  ServiceRequest[]
  flyers           VendorFlyer[]

  membershipStatus             MembershipStatus @default(NONE)
  membershipTier                String?
  stripeCustomerId             String?
  stripeSubscriptionId         String?
  membershipActivatedAt        DateTime?
  membershipCurrentPeriodEnd   DateTime?
  membershipCanceledAt         DateTime?

  applicationFeePaidAt          DateTime?
  foundingVendor                Boolean          @default(false)
}

model VendorFlyer {
  id              String            @id @default(cuid())
  vendorProfileId String
  vendorProfile   VendorProfile     @relation(fields: [vendorProfileId], references: [id])
  fileName        String
  label           String
  status          ApplicationStatus @default(PENDING)
  uploadedAt      DateTime          @default(now())
  reviewedAt      DateTime?
}

model FinancingPartnerProfile {
  id                String            @id @default(cuid())
  userId            String            @unique
  user              User              @relation(fields: [userId], references: [id])
  companyName       String
  licenseInfo       String
  status            ApplicationStatus @default(PENDING)
  appliedAt         DateTime          @default(now())
  reviewedAt        DateTime?
  financingRequests FinancingRequest[]

  paymentStatus         PaymentStatus @default(UNPAID)
  stripeCustomerId      String?
  stripePaymentIntentId String?
  paidAt                DateTime?
}

model Document {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  label      String
  fileName   String
  uploadedAt DateTime @default(now())
}

model FinancingRequest {
  id                 String         @id @default(cuid())
  homeownerId        String
  homeowner          User           @relation(fields: [homeownerId], references: [id])
  projectDescription String
  amountRequested    Int
  status             RequestStatus  @default(NEW)
  assignedPartnerId  String?
  assignedPartner    FinancingPartnerProfile? @relation(fields: [assignedPartnerId], references: [id])
  notes              String?
  createdAt          DateTime       @default(now())
}

model ServiceRequest {
  id               String          @id @default(cuid())
  homeownerId      String
  homeowner        User            @relation(fields: [homeownerId], references: [id])
  serviceType      String
  description      String
  status           RequestStatus   @default(NEW)
  assignedVendorId String?
  assignedVendor   VendorProfile?  @relation(fields: [assignedVendorId], references: [id])
  createdAt        DateTime        @default(now())
  appointment      Appointment?

  // Deprecated: homeowner-pays-vendor-directly flow has been removed from the app.
  // Left in place (unused) rather than dropped, to avoid a destructive migration over
  // what's currently just test data.
  priceCents              Int?
  paymentStatus           PaymentStatus @default(UNPRICED)
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  paidAt                  DateTime?

  estimateLowCents  Int?
  estimateHighCents Int?
}

model Appointment {
  id               String          @id @default(cuid())
  homeownerId      String
  homeowner        User            @relation(fields: [homeownerId], references: [id])
  serviceRequestId String?         @unique
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id])
  scheduledFor     DateTime
  status           String          @default("SCHEDULED")
  createdAt        DateTime        @default(now())
}
